<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      MCP traffic (local gateway + optional LAN remote servers) is plain HTTP.
      Everything else (chat.deepseek.com etc.) still verifies system certs.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
